PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/campusbite
MONGODB_DB_NAME=campusbite
JWT_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-another-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Optional email delivery (Mailgun HTTP API)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mx.adarsh.run
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_SENDER_NAME=CampusBite
# Defaults to campusbite@<MAILGUN_DOMAIN>
# MAILGUN_FROM_EMAIL=campusbite@mx.adarsh.run

# Optional overrides for npm run seed:admin
# ADMIN_EMAIL=adarsh@campusbite
# ADMIN_PASSWORD=password1234
